{
  "name": "rpn-travels-backend",
  "version": "1.0.0",
  "description": "Backend server for RPN Travels OpenAI API proxy",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "ip": "curl -sS https://ifconfig.me && echo",
    "pan:test:direct": "sh -c 'set -a && . ./.env && set +a && curl --location --fail-with-body \"$CGEPY_VERIFY_URL\" --header \"Content-Type: application/json\" --header \"x-merchant-id: $CGEPY_MERCHANT_ID\" --header \"x-api-key: $CGEPY_API_KEY\" --header \"x-secret-key: $CGEPY_SECRET_KEY\" --data \"{\\\"pan\\\":\\\"AZYPH1234W\\\"}\"'",
    "pan:test:local": "curl --location --fail-with-body http://localhost:3000/api/v1/verify/pan --header Content-Type:application/json --data '{\"pan\":\"AZYPH1234W\"}'"
  },
  "keywords": [
    "rpn-travels",
    "openai",
    "api-proxy"
  ],
  "author": "RPN Travels",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.6",
    "multer": "^2.2.0",
    "node-fetch": "^2.6.9"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
